{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "SDK container",
      "vendor": {
        "jetbrains.com/clion": { "toolchain": "Docker" }
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ide",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_HIP_ARCHITECTURES": "gfx942"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" }
  ]
}
